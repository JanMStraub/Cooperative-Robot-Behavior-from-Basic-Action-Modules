{
  "venvPath": ".",
  "venv": "acrl",
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "reportUnusedParameter": "none",
  "extraPaths": [
    "tests/integration/helpers"
  ],
  "ignore": [
    "ros2/**",
    "ros_unity_integration/**"
  ],
  "exclude": [
    "ros2/**",
    "ros_unity_integration/**",
    "**/node_modules",
    "**/__pycache__",
    "**/.*"
  ]
}
